<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/studyos_widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_task_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 12"
        android:textColor="#F59E0B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_task_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyOS Daily Goals"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the streak alive! 🚀"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_task_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/studyos_widget_button"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp" />

</LinearLayout>
