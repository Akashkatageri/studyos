<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/studyos_widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Mascot Avatar Badge -->
    <LinearLayout
        android:id="@+id/widget_task_avatar_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/studyos_widget_badge_bg"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/widget_task_avatar_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/panda_ready"
            android:scaleType="fitCenter"
            android:contentDescription="Mascot" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_task_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 12 Streak"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_pstatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Ready"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Goals &amp; Tasks"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/widget_task_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to study! ☀️"
            android:textColor="#E2E8F0"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_task_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goals"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/studyos_widget_button"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginStart="6dp" />

</LinearLayout>
