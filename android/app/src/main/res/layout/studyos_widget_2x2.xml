<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_purple"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/widget_2x2_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="🔥 0"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_streak_text_size"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/widget_2x2_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_2x2_streak"
        android:layout_alignParentStart="true"
        android:layout_marginTop="2dp"
        android:text="Ready to learn?"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_title_text_size"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_2x2_mascot"
        android:layout_width="@dimen/widget_mascot_2x2_size"
        android:layout_height="@dimen/widget_mascot_2x2_size"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/happy"
        android:contentDescription="@string/widget_mascot_description"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/widget_2x2_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/widget_pill_bg"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Start now"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/widget_pill_text_size"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>
