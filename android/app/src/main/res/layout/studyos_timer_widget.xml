<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/studyos_widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Mascot Avatar Badge -->
    <LinearLayout
        android:id="@+id/widget_timer_avatar_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/studyos_widget_badge_bg"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/widget_timer_avatar_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/panda_ready"
            android:scaleType="fitCenter"
            android:contentDescription="Mascot" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_timer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Focus Timer"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_timer_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/widget_timer_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today: 0 min"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_timer_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start 🚀"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/studyos_widget_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
