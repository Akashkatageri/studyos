<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/studyos_widget_background"
    android:padding="12dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_timer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Focus Timer"
        android:textColor="#F59E0B"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_timer_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/widget_timer_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today: 0 min"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_timer_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶ Start Focus"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/studyos_widget_button"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
