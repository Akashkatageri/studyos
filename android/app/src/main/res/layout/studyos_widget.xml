<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/studyos_widget_background"
    android:padding="14dp"
    android:gravity="center">

    <!-- Top Row: Brand Header & Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PanPan Companion"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_pstatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Ready"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/studyos_widget_pstatus_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Center Content: Mascot Avatar Badge & Mascot Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Prominent Mascot Badge (58dp) -->
        <LinearLayout
            android:id="@+id/widget_avatar_bg"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/studyos_widget_badge_bg"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/widget_avatar_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/panda_ready"
                android:scaleType="fitCenter"
                android:contentDescription="StudyOS Mascot" />
        </LinearLayout>

        <!-- Main Stat: Streak Chip -->
        <TextView
            android:id="@+id/widget_main_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 12 Day Streak"
            android:textColor="#FBBF24"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/studyos_widget_streak_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

        <!-- Mascot Subtext Quote -->
        <TextView
            android:id="@+id/widget_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PanPan is ready to study! ☀️"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Bottom Action Button -->
    <TextView
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Study Session 🚀"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/studyos_widget_button"
        android:paddingVertical="9dp"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="6dp" />

</LinearLayout>
