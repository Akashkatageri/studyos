<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/studyos_widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Avatar / Native Mascot Vector Badge (48dp) -->
    <LinearLayout
        android:id="@+id/widget_avatar_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/studyos_widget_badge_bg"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/widget_avatar_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/panda_ready"
            android:scaleType="fitCenter"
            android:contentDescription="StudyOS Mascot" />
    </LinearLayout>

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Top Row: Brand & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="StudyOS"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/widget_pstatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Ready"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Stat: Streak / XP -->
        <TextView
            android:id="@+id/widget_main_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 12 Day Streak"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp" />

        <!-- Status Message / Duolingo Copy -->
        <TextView
            android:id="@+id/widget_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to study! ☀️"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Action Button -->
    <TextView
        android:id="@+id/widget_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/studyos_widget_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:layout_marginStart="8dp" />

</LinearLayout>

