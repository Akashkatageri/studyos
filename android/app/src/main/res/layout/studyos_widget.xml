<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/studyos_widget_background"
    android:padding="12dp"
    android:gravity="center">

    <!-- Top Row: Brand Header & Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PanPan Companion"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/widget_pstatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Ready"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Content: Mascot Avatar Badge & Mascot Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Prominent Vector Mascot Badge (54dp) -->
        <LinearLayout
            android:id="@+id/widget_avatar_bg"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/studyos_widget_badge_bg"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/widget_avatar_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/panda_ready"
                android:scaleType="fitCenter"
                android:contentDescription="StudyOS Mascot" />
        </LinearLayout>

        <!-- Main Stat: Streak -->
        <TextView
            android:id="@+id/widget_main_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 12 Day Streak"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Mascot Subtext Quote -->
        <TextView
            android:id="@+id/widget_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PanPan is ready to study! ☀️"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Bottom Action Button -->
    <TextView
        android:id="@+id/widget_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Study Session 🚀"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/studyos_widget_button"
        android:paddingVertical="7dp"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="4dp" />

</LinearLayout>


